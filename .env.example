# Скопируйте этот файл в .env и заполните значениями под своё окружение.
# Секретный ключ Flask можно сгенерировать командой:
#   python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=

# Ключ доступа и ID сообщества VK (для публикации постов)
VK_TOKEN=
VK_GROUP_ID=

# DeepSeek через ProxyAPI (OpenAI-совместимый API, ключ из кабинета proxyapi.ru)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/v1
OPENAI_MODEL=deepseek/deepseek-chat
